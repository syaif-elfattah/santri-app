# Salin file ini menjadi .env.local dan isi nilainya
# Dapatkan dari: https://app.supabase.com > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # jangan expose ke client!

# Secret untuk JWT session admin (buat string acak panjang)
ADMIN_JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Password admin awal (setelah setup, hash ini disimpan di database)
# Jalankan: node scripts/setup-admin.js untuk inisialisasi
ADMIN_PASSWORD_AWAL=admin123
